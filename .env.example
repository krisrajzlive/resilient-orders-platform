# Copy to .env (git-ignored). Never commit real values.
AWS_PROFILE=udacity-lab
AWS_REGION=us-east-1

# Bedrock model ids (cross-region inference profiles use the us. prefix)
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
GENERATION_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
REASONING_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
FALLBACK_MODEL_ID=amazon.nova-lite-v1:0

# Local pgvector database (docker compose up -d)
DATABASE_URL=postgresql://orders:orders-local-dev@127.0.0.1:5433/orders
